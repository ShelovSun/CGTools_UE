QWidget
{
    background-color: rgb(43, 43, 43);
    color: rgb(230, 230, 230)
}
QToolTip
{
     border: 1px solid black;
     background-color: #f0f0f0;
     padding: 1px;
     border-radius: 3px;
     opacity: 100;
}

QListWidget
{
    color: #b1b1b1;
    background-color: rgb(26, 26, 26);
    font-size: 13px;
    border:2px solid #1a1a1a;
}

QListWidget:item:selected,QListWidget:item:hover,QLineEdit:hover,QLineEdit:focus
{
    border: 1px solid #7d7d7d;
    color: rgb(243, 243, 243)
}

QListWidget:focus
{
    outline: none;
    color: rgb(243, 243, 243)
}

QMenuBar::item
{
    background: transparent;
}

QMenuBar::item:selected
{
    background: transparent;
    border: 1px solid #26bbff;
}

QMenuBar::item:pressed
{
    background: #444;
    border: 1px solid #000;
    background-color: QLinearGradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:1 #212121,
        stop:0.4 #343434
    );
    margin-bottom:-1px;
    padding-bottom:1px;
}

QMenu
{
    border: 1px solid #000;
}

QMenu::item
{
    padding: 2px 20px 2px 20px;
}

QMenu::item:selected
{
    color: #000000;
}

QLineEdit
{
    background-color: rgb(15, 15, 15);
    padding: 1px;
    border-style: solid;
    border: 1px solid #1e1e1e;
    border-radius: 5;
    color: rgb(243, 243, 243)
}

QPushButton
{
    background-color: rgb(70, 70, 70);
    border-radius: 1;
    padding: 3px;
    font-size: 13px;
    padding-left: 5px;
    padding-right: 5px;
}

QPushButton:pressed
{
    background-color: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #2d2d2d, stop: 0.1 #2b2b2b, stop: 0.5 #292929, stop: 0.9 #282828, stop: 1 #252525);
}

QPushButton:disabled{
	color: rgb(100, 100, 100);
	border-color: brown;
    background-color: rgb(70, 70, 70);
}


QComboBox
{
    selection-background-color: #ffaa00;
    background-color: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #565656, stop: 0.1 #525252, stop: 0.5 #4e4e4e, stop: 0.9 #4a4a4a, stop: 1 #464646);
    border-style: solid;
    border: 1px solid #1e1e1e;
    border-radius: 5;
}

QComboBox:hover,QPushButton:hover
{
    border: 1px solid #7d7d7d;
}


QComboBox:on
{
    padding-top: 3px;
    padding-left: 4px;
    background-color: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #2d2d2d, stop: 0.1 #2b2b2b, stop: 0.5 #292929, stop: 0.9 #282828, stop: 1 #252525);
    selection-background-color: #ffaa00;
}

QComboBox QAbstractItemView
{
    border: 2px solid darkgray;
    selection-background-color: #151515;
}

QComboBox::drop-down
{
     subcontrol-origin: padding;
     subcontrol-position: top right;
     width: 15px;

     border-left-width: 0px;
     border-left-color: darkgray;
     border-left-style: solid;
     border-top-right-radius: 3px;
     border-bottom-right-radius: 3px;
 }

QComboBox::down-arrow
{
     image: url(:/down_arrow.png);
}

QGroupBox
{
border: 2px solid #424242;
}

QSlider::groove:horizontal
{
background: #000000;
height: 3px;
border-radius: 1px;
padding-left:-1px;
padding-right:-1px;
}

QSlider::handle:horizontal
{
    background: #a1a1a1;
    width: 8px;
    margin-top: -10px;
    margin-bottom: -10px;
    border: 2px solid #303030;
}

QTextEdit:focus
{
    border: 2px solid QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #5c5c5c, stop: 1 #5c5c5c);
}

QScrollBar:horizontal {
     border: 1px solid #222222;
     background: #1a1a1a;
     height: 12px;
     margin: 0px 16px 0 16px;
}

QScrollBar::handle:horizontal
{
      background: #575757;
      min-height: 20px;
      border-radius: 2px;
}

QScrollBar::add-line:horizontal {
      border: 1px solid #1b1b19;
      border-radius: 2px;
      background: #575757;
      width: 25px;
      subcontrol-position: right;
      subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
      border: 1px solid #1b1b19;
      border-radius: 2px;
      background: #575757;
      width: 25px;
     subcontrol-position: left;
     subcontrol-origin: margin;
}

QScrollBar::right-arrow:horizontal, QScrollBar::left-arrow:horizontal
{
      border: 1px solid black;
      width: 1px;
      height: 1px;
      background: white;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
      background: none;
}

QScrollBar:vertical
{
      background: #1a1a1a;
      width: 12px;
      margin: 10px 0 10px 0;
      border: 0px solid #1a1a1a;
}

QScrollBar::handle:vertical
{
      background: #575757;
      min-height: 20px;
      border-radius: 2px;
}

QScrollBar::add-line:vertical
{
      border: 1px solid #1b1b19;
      border-radius: 2px;
      background: #1a1a1a;
      height: 10px;
      subcontrol-position: bottom;
      subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical
{
      border: 1px solid #1b1b19;
      border-radius: 2px;
      background: #1a1a1a;
      height: 10px;
      subcontrol-position: top;
      subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical
{
      border: 1px solid black;
      width: 0px;
      height: 0px;
      background: white;
}


QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
      background: none;
}

QTextEdit
{
    background-color: #242424;
}

QPlainTextEdit
{
    background-color: #242424;
}

QHeaderView::section
{
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #616161, stop: 0.5 #505050, stop: 0.6 #434343, stop:1 #656565);
    color: white;
    padding-left: 4px;
    border: 1px solid #6c6c6c;
}

QCheckBox:disabled
{
    color: #414141;
}

QDockWidget::title
{
    text-align: center;
    spacing: 3px;
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #323232, stop: 0.5 #242424, stop:1 #323232);
}

QDockWidget::close-button, QDockWidget::float-button
{
    text-align: center;
    spacing: 1px;
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #323232, stop: 0.5 #242424, stop:1 #323232);
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover
{
    background: #242424;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed
{
    padding: 1px -1px -1px 1px;
}

QMainWindow::separator
{
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #161616, stop: 0.5 #151515, stop: 0.6 #212121, stop:1 #343434);
    color: white;
    padding-left: 4px;
    border: 1px solid #4c4c4c;
    spacing: 3px;
}

QMainWindow::separator:hover
{

    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d7801a, stop:0.5 #b56c17 stop:1 #18a0fb);
    color: white;
    padding-left: 4px;
    border: 1px solid #6c6c6c;
    spacing: 3px;
}

QToolBar::handle
{
     spacing: 3px;
     background: url(:/images/handle.png);
}

QMenu::separator
{
    height: 2px;
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:0 #161616, stop: 0.5 #151515, stop: 0.6 #212121, stop:1 #343434);
    color: white;
    padding-left: 4px;
    margin-left: 10px;
    margin-right: 5px;
}

QProgressBar
{
    border: 2px solid grey;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk
{
    background-color: #d7801a;
    width: 2.15px;
    margin: 0.5px;
}

QTabBar::tab {
    color: #b1b1b1;
    border: 1px solid #444;
    border-bottom-style: none;
    background-color: #323232;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 2px;
    margin-right: -1px;
}

QTabWidget::pane {
    border: 1px solid #444;
    top: 1px;
}

QTabBar::tab:last
{
    margin-right: 0;
    border-top-right-radius: 3px;
}

QTabBar::tab:first:!selected
{
    margin-left: 0px;
    border-top-left-radius: 3px;
}

QTabBar::tab:!selected
{
    color: #b1b1b1;
    border-bottom-style: solid;
    margin-top: 3px;
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:1 #212121, stop:.4 #343434);
}

QTabBar::tab:selected
{
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-bottom: 0px;
}

QTabBar::tab:!selected:hover
{
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background-color: QLinearGradient(x1:0, y1:0, x2:0, y2:1, stop:1 #212121, stop:0.4 #343434, stop:0.2 #343434, stop:0.1 #18a0fb);
}

QRadioButton::indicator:checked, QRadioButton::indicator:unchecked{
    color: #b1b1b1;
    background-color: #323232;
    border: 1px solid #b1b1b1;
    border-radius: 6px;
}

QRadioButton::indicator:checked
{
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5,
        fx: 0.5, fy: 0.5,
        radius: 1.0,
        stop: 0.25 #26bbff,
        stop: 0.3 #323232
    );
}


QRadioButton::indicator
{
    border-radius: 6px;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover
{
    border: 1px solid #26bbff;
}

QRadioButton::enabled
{
    color: rgb(243, 243, 243);
}


/* -------------------------------------------------------------------------
   Reusable Unreal-style top-level window chrome.
   Create UEWindowTitleBar / UEWindowFrameOverlay in Python, then call
   apply_ue_stylesheet(window). New windows should not duplicate these rules.
   ------------------------------------------------------------------------- */

QWidget[ueFramelessWindow="true"]
{
    background-color: #202020;
    border: none;
}

QWidget#UEWindowTitleBar
{
    background-color: #151515;
    border: none;
    border-bottom: 1px solid #292929;
    qproperty-titleBackgroundColor: #151515;
    qproperty-separatorColor: #292929;
}

QWidget#UEWindowTitleSide,
QLabel#UEWindowLogo
{
    background: transparent;
    border: none;
}

QLabel#UEWindowTitle
{
    background: transparent;
    border: none;
    color: #d0d0d0;
    font-size: 13px;
    font-weight: normal;
    padding: 0px;
}

QPushButton#UEWindowCloseButton
{
    background: transparent;
    border: none;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
    qproperty-normalGlyphColor: #bdbdbd;
    qproperty-hoverGlyphColor: #ffffff;
}

QPushButton#UEWindowCloseButton:hover
{
    background: #c42b1c;
    border: none;
}

QPushButton#UEWindowCloseButton:pressed
{
    background: #9e2117;
    border: none;
}

QWidget#UEWindowFrameOverlay
{
    background: transparent;
    border: none;
    qproperty-outerBorderColor: #050505;
    qproperty-outerBorderWidth: 2;
    qproperty-highlightBorderColor: #484848;
    qproperty-innerBorderColor: #111111;
}

QSizeGrip#UEWindowResizeGrip
{
    background: transparent;
    border: none;
    qproperty-gripColor: #747474;
}

QSplitter#AssetDetailsSplitter::handle:vertical,
QSplitter#SceneDetailsSplitter::handle:vertical
{
    height: 5px;
    background: #151515;
    border-top: 1px solid #454545;
    border-bottom: 1px solid #050505;
}

QSplitter#AssetDetailsSplitter::handle:vertical:hover,
QSplitter#SceneDetailsSplitter::handle:vertical:hover
{
    background: #315d78;
    border-top-color: #65a8cf;
}

QSplitter#AssetMainSplitter::handle:horizontal,
QSplitter#SceneMainSplitter::handle:horizontal
{
    width: 5px;
    background: #151515;
    border-left: 1px solid #050505;
    border-right: 1px solid #454545;
}

QSplitter#AssetMainSplitter::handle:horizontal:hover,
QSplitter#SceneMainSplitter::handle:horizontal:hover
{
    background: #315d78;
    border-right-color: #65a8cf;
}

